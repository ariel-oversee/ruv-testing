# AI Knowledge Nexus - Live Scraper Configuration

# ===========================================
# API Keys (Required for Production)
# ===========================================

# GitHub API Token (for higher rate limits)
GITHUB_API_TOKEN=your_github_token_here

# YouTube Data API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# ===========================================
# Rate Limiting Configuration
# ===========================================

# Default rate limit (requests per minute)
RATE_LIMIT_DEFAULT=10

# ArXiv rate limit
RATE_LIMIT_ARXIV=5

# PubMed rate limit
RATE_LIMIT_PUBMED=3

# GitHub rate limit
RATE_LIMIT_GITHUB=30

# YouTube rate limit
RATE_LIMIT_YOUTUBE=20

# Wikipedia rate limit
RATE_LIMIT_WIKIPEDIA=20

# ===========================================
# Politeness Configuration
# ===========================================

# Default delay between requests (milliseconds)
DELAY_DEFAULT=1000

# Respectful delay (for sensitive sources)
DELAY_RESPECTFUL=2000

# Aggressive delay (for high-volume scraping)
DELAY_AGGRESSIVE=500

# ===========================================
# Chunking Configuration
# ===========================================

# Default chunking strategy (fixed|sentence|paragraph|semantic)
CHUNK_STRATEGY=sentence

# Chunk size (in tokens/words)
CHUNK_SIZE=1024

# Chunk overlap (in tokens/words)
CHUNK_OVERLAP=128

# ===========================================
# Content Configuration
# ===========================================

# Maximum content length (bytes)
MAX_CONTENT_LENGTH=10485760

# Enable content compression
ENABLE_COMPRESSION=true

# Content encoding (utf-8|ascii)
CONTENT_ENCODING=utf-8

# ===========================================
# Distributed Scraping
# ===========================================

# Enable distributed mode
DISTRIBUTED_MODE=false

# Node ID (auto-generated if not specified)
NODE_ID=

# Number of workers for distributed scraping
WORKERS=4

# Redis connection (for distributed coordination)
REDIS_URL=redis://localhost:6379

# ===========================================
# Monitoring Configuration
# ===========================================

# Enable monitoring
ENABLE_MONITORING=true

# Default monitoring interval (milliseconds)
MONITOR_INTERVAL=60000

# Maximum active monitors
MAX_MONITORS=100

# ===========================================
# Cache Configuration
# ===========================================

# Enable content caching
ENABLE_CACHE=true

# Cache TTL (seconds)
CACHE_TTL=3600

# Maximum cache size (items)
CACHE_MAX_SIZE=10000

# Cache eviction strategy (lru|lfu|fifo)
CACHE_STRATEGY=lru

# ===========================================
# Database Configuration
# ===========================================

# Database type (postgres|mongodb|sqlite)
DATABASE_TYPE=postgres

# PostgreSQL connection
POSTGRES_URL=postgresql://user:password@localhost:5432/scraper

# MongoDB connection
MONGODB_URL=mongodb://localhost:27017/scraper

# SQLite file path
SQLITE_PATH=./data/scraper.db

# ===========================================
# Logging Configuration
# ===========================================

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Log format (json|text)
LOG_FORMAT=json

# Log output (file|console|both)
LOG_OUTPUT=console

# Log file path
LOG_FILE_PATH=./logs/scraper.log

# ===========================================
# Security Configuration
# ===========================================

# Enable robots.txt respect
RESPECT_ROBOTS_TXT=true

# User agent string
USER_AGENT=AI-Knowledge-Nexus/1.0 (Educational; +https://github.com/ai-knowledge-nexus)

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Maximum redirects
MAX_REDIRECTS=5

# Enable SSL verification
SSL_VERIFY=true

# ===========================================
# Performance Configuration
# ===========================================

# Enable parallel processing
ENABLE_PARALLEL=true

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Request retry attempts
RETRY_ATTEMPTS=3

# Retry delay (milliseconds)
RETRY_DELAY=1000

# Enable request queuing
ENABLE_QUEUE=true

# Queue max size
QUEUE_MAX_SIZE=1000

# ===========================================
# Content Processing
# ===========================================

# Enable content cleaning
ENABLE_CLEANING=true

# Remove images
REMOVE_IMAGES=false

# Remove links
REMOVE_LINKS=false

# Extract metadata
EXTRACT_METADATA=true

# Enable deduplication
ENABLE_DEDUPLICATION=true

# Deduplication threshold (0.0-1.0)
DEDUP_THRESHOLD=0.8

# ===========================================
# Source-Specific Configuration
# ===========================================

# ArXiv API endpoint
ARXIV_API_URL=https://export.arxiv.org/api/query

# PubMed API endpoint
PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# GitHub API endpoint
GITHUB_API_URL=https://api.github.com

# YouTube API endpoint
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3

# Wikipedia API endpoint
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# ===========================================
# Feature Flags
# ===========================================

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable OCR for images
ENABLE_OCR=false

# Enable video processing
ENABLE_VIDEO_PROCESSING=false

# Enable PDF extraction
ENABLE_PDF_EXTRACTION=true

# Enable JSON-LD extraction
ENABLE_JSONLD=true

# Enable Open Graph extraction
ENABLE_OPENGRAPH=true

# ===========================================
# Telemetry and Analytics
# ===========================================

# Enable telemetry
ENABLE_TELEMETRY=true

# Telemetry endpoint
TELEMETRY_URL=

# Enable performance metrics
ENABLE_METRICS=true

# Metrics collection interval (milliseconds)
METRICS_INTERVAL=60000

# ===========================================
# Development Configuration
# ===========================================

# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE=false

# Mock external requests (for testing)
MOCK_REQUESTS=false

# Simulate delays (for testing)
SIMULATE_DELAYS=false
