{
  "name": "ai-knowledge-nexus",
  "version": "2.0.0",
  "description": "🧠 Advanced AI Knowledge Management System - Vector Search, RAG, Multi-Modal Embeddings, Neural Search & Interactive CLI",
  "main": "src/index.js",
  "type": "commonjs",
  "bin": {
    "nexus": "./src/cli/nexus-cli.js",
    "nexus-demo": "./demo.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli/nexus-cli.js",
    "demo": "node demo.js",
    "demo:full": "node demo.js --full",
    "demo:performance": "node demo.js --performance",
    "demo:rag": "node demo.js --rag",
    "demo:search": "node demo.js --search",
    "demo:scraper": "node demo.js --scraper",
    "demo:viz": "node demo.js --viz",
    "bench": "node src/bench/performance-engine.js",
    "scrape": "node src/scraper/live-scraper.js",
    "dev": "nodemon src/index.js",
    "dev:cli": "nodemon src/cli/nexus-cli.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "docs": "jsdoc -c jsdoc.json",
    "build": "npm run lint && npm run test",
    "install-global": "npm install -g .",
    "uninstall-global": "npm uninstall -g ai-knowledge-nexus",
    "postinstall": "node scripts/postinstall.js || true"
  },
  "keywords": [
    "ai",
    "knowledge-management",
    "vector-search",
    "rag",
    "retrieval-augmented-generation",
    "embeddings",
    "semantic-search",
    "neural-search",
    "machine-learning",
    "nlp",
    "deep-learning",
    "information-retrieval",
    "knowledge-graph",
    "cli",
    "interactive",
    "visualization",
    "web-scraping",
    "data-extraction",
    "performance-monitoring",
    "benchmarking"
  ],
  "author": "AI Knowledge Nexus Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-knowledge-nexus/nexus"
  },
  "bugs": {
    "url": "https://github.com/ai-knowledge-nexus/nexus/issues"
  },
  "homepage": "https://github.com/ai-knowledge-nexus/nexus#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "gradient-string": "^2.0.2",
    "figlet": "^1.7.0",
    "inquirer": "^8.2.6",
    "inquirer-autocomplete-prompt": "^2.0.1",
    "ora": "^5.4.1",
    "boxen": "^5.1.2",
    "cli-table3": "^0.6.3",
    "blessed": "^0.1.81",
    "asciichart": "^1.5.25",
    "cli-progress": "^3.12.0",
    "fuzzy": "^0.1.3",
    "cli-highlight": "^2.1.11",
    "terminal-kit": "^3.0.1",
    "ansi-escapes": "^4.3.2",
    "log-update": "^4.0.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^21.6.0",
    "playwright": "^1.40.1",
    "jsdom": "^23.0.1",
    "natural": "^6.10.0",
    "compromise": "^14.10.0",
    "franc": "^6.1.0",
    "stopword": "^2.0.8",
    "stemmer": "^2.0.1",
    "fast-levenshtein": "^3.0.0",
    "fuzzysort": "^2.0.4",
    "lunr": "^2.3.9",
    "flexsearch": "^0.7.43",
    "d3": "^7.8.5",
    "pdfjs-dist": "^4.0.189",
    "mammoth": "^1.6.0",
    "xlsx": "^0.18.5",
    "csv-parse": "^5.5.3",
    "xml2js": "^0.6.2",
    "yaml": "^2.3.4",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "pino": "^8.17.1",
    "debug": "^4.3.4",
    "bull": "^4.12.0",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "lru-cache": "^10.1.0",
    "node-cache": "^5.1.2",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "fastify": "^4.25.1",
    "ws": "^8.15.1",
    "socket.io": "^4.6.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^4.0.1",
    "uuid": "^9.0.1",
    "nanoid": "^3.3.7",
    "short-uuid": "^4.2.2",
    "commander": "^11.1.0",
    "yargs": "^17.7.2",
    "minimist": "^1.2.8",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.10",
    "zod": "^3.22.4",
    "joi": "^17.11.0",
    "ajv": "^8.12.0",
    "lodash": "^4.17.21",
    "underscore": "^1.13.6",
    "ramda": "^0.29.1",
    "async": "^3.2.5",
    "bluebird": "^3.7.2",
    "p-queue": "^6.6.2",
    "p-limit": "^3.1.0",
    "p-map": "^4.0.0",
    "p-retry": "^4.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.3",
    "nock": "^13.4.0",
    "sinon": "^17.0.1",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "jsdoc": "^4.0.2",
    "jsdoc-to-markdown": "^8.0.0",
    "markdown-toc": "^1.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "commitlint": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.15.0",
    "onnxruntime-node": "^1.16.3",
    "faiss-node": "^0.5.1",
    "hnswlib-node": "^1.4.2",
    "node-gyp": "^10.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/cli/**/*.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
